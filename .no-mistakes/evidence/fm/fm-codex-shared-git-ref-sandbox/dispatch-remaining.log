    return busyEvent("idle", "agent-settled");
  });
  pi.on("turn_end", () => execFile("touch", ["/private/var/folders/70/p814fs691f103nxddhx58mhh0000gn/T/fm-spawn-dispatch-profile.QZQzLG/profile-pi-signed/home/state/profile-pi-signed-z8b.turn-ended"]));
